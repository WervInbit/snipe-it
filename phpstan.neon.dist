includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./phpstan-baseline.neon

parameters:
    # Allow baseline debt to shrink without making focused analysis or CI fail
    # because a previously ignored error is no longer present.
    reportUnmatchedIgnoredErrors: false

    paths:
        - app
        - config
        - database/migrations
        - resources/lang
        - resources/views

    level: 4
