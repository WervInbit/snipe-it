<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    # Make sure .env files not not browseable if in a sub-directory.
    <FilesMatch "\.env$">
       # Apache 2.2
       <IfModule !authz_core_module>
          Deny from all
       </IfModule>
       
       # Apache 2.4+
       <IfModule authz_core_module>
          Require all denied
       </IfModule>
    </FilesMatch>

    # Defense in depth for installations whose document root is the project
    # root: files under either upload tree must never execute as scripts.
    RewriteEngine On
    RewriteRule ^(public/)?uploads/test_images(/.*)?$ - [F,L,NC]
    RewriteRule ^(public/)?uploads/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)(/.*)?$ - [F,L,NC]
    
</IfModule>
